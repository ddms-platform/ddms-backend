[
  {
    "caseName": "EmailEmpty_ThrowsValidation",
    "email": "   ",
    "password": "Abcdefg1!",
    "userExists": false,
    "hasPasswordHash": false,
    "passwordMatches": false,
    "expectedException": "Validation",
    "expectedFieldErrorKey": "email"
  },
  {
    "caseName": "PasswordEmpty_ThrowsValidation",
    "email": "user@example.com",
    "password": "   ",
    "userExists": false,
    "hasPasswordHash": false,
    "passwordMatches": false,
    "expectedException": "Validation",
    "expectedFieldErrorKey": "password"
  },
  {
    "caseName": "UserNotFound_ThrowsInvalidCredentials",
    "email": "notfound@example.com",
    "password": "Abcdefg1!",
    "userExists": false,
    "hasPasswordHash": false,
    "passwordMatches": false,
    "expectedException": "InvalidCredentials",
    "expectedFieldErrorKey": null
  },
  {
    "caseName": "SocialAccountNoPassword_ThrowsInvalidCredentials",
    "email": "user@example.com",
    "password": "Abcdefg1!",
    "userExists": true,
    "hasPasswordHash": false,
    "passwordMatches": false,
    "expectedException": "InvalidCredentials",
    "expectedFieldErrorKey": null
  },
  {
    "caseName": "WrongPassword_ThrowsInvalidCredentials",
    "email": "user@example.com",
    "password": "WrongPass1!",
    "userExists": true,
    "hasPasswordHash": true,
    "passwordMatches": false,
    "expectedException": "InvalidCredentials",
    "expectedFieldErrorKey": null
  },
  {
    "caseName": "ValidCredentials_Success",
    "email": "user@example.com",
    "password": "Abcdefg1!",
    "userExists": true,
    "hasPasswordHash": true,
    "passwordMatches": true,
    "expectedException": null,
    "expectedFieldErrorKey": null
  }
]
