[
  {
    "caseName": "EmptyToken_ThrowsInvalid",
    "refreshToken": "   ",
    "tokenExists": false,
    "revoked": false,
    "expiresInHoursOffset": 0,
    "expectedException": "Invalid"
  },
  {
    "caseName": "TokenNotFound_ThrowsInvalid",
    "refreshToken": "some-token",
    "tokenExists": false,
    "revoked": false,
    "expiresInHoursOffset": 0,
    "expectedException": "Invalid"
  },
  {
    "caseName": "TokenRevoked_ThrowsReuseDetected",
    "refreshToken": "some-token",
    "tokenExists": true,
    "revoked": true,
    "expiresInHoursOffset": 24,
    "expectedException": "ReuseDetected"
  },
  {
    "caseName": "TokenExpired_ThrowsExpired",
    "refreshToken": "some-token",
    "tokenExists": true,
    "revoked": false,
    "expiresInHoursOffset": -1,
    "expectedException": "Expired"
  },
  {
    "caseName": "ValidToken_Success",
    "refreshToken": "some-token",
    "tokenExists": true,
    "revoked": false,
    "expiresInHoursOffset": 24,
    "expectedException": null
  }
]
