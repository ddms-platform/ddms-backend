[
  {
    "caseName": "BookingNotFound_ThrowsNotFound",
    "bookingFound": false,
    "status": "pending",
    "departingInDays": 10,
    "walletExists": false,
    "expectedException": "NotFound",
    "expectedStatus": null,
    "expectedRefunded": false,
    "expectedCancelReason": null
  },
  {
    "caseName": "AlreadyCancelled_ThrowsUncategorizedError",
    "bookingFound": true,
    "status": "cancelled",
    "departingInDays": 10,
    "walletExists": false,
    "expectedException": "AlreadyCancelled",
    "expectedStatus": null,
    "expectedRefunded": false,
    "expectedCancelReason": null
  },
  {
    "caseName": "NotPaid_CancelsWithoutRefund",
    "bookingFound": true,
    "status": "pending",
    "departingInDays": 10,
    "walletExists": false,
    "expectedException": null,
    "expectedStatus": "cancelled",
    "expectedRefunded": false,
    "expectedCancelReason": "Hủy bởi khách hàng"
  },
  {
    "caseName": "Holding_CancelsWithoutRefund",
    "bookingFound": true,
    "status": "holding",
    "departingInDays": 10,
    "walletExists": false,
    "expectedException": null,
    "expectedStatus": "cancelled",
    "expectedRefunded": false,
    "expectedCancelReason": "Hủy bởi khách hàng"
  },
  {
    "caseName": "Paid_WithinRefundWindow_NoExistingWallet_Refunds",
    "bookingFound": true,
    "status": "paid",
    "departingInDays": 10,
    "walletExists": false,
    "expectedException": null,
    "expectedStatus": "cancelled",
    "expectedRefunded": true,
    "expectedCancelReason": "Hủy bởi khách hàng (Được hoàn tiền)"
  },
  {
    "caseName": "Paid_WithinRefundWindow_ExistingWallet_Refunds",
    "bookingFound": true,
    "status": "confirmed",
    "departingInDays": 10,
    "walletExists": true,
    "expectedException": null,
    "expectedStatus": "cancelled",
    "expectedRefunded": true,
    "expectedCancelReason": "Hủy bởi khách hàng (Được hoàn tiền)"
  },
  {
    "caseName": "Paid_TooCloseToDeparture_NoRefund",
    "bookingFound": true,
    "status": "paid",
    "departingInDays": 1,
    "walletExists": false,
    "expectedException": null,
    "expectedStatus": "cancelled",
    "expectedRefunded": false,
    "expectedCancelReason": "Hủy bởi khách hàng (Không hoàn tiền - Sát ngày khởi hành < 2 ngày)"
  }
]
