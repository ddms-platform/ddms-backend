[
  {
    "caseName": "EmailEmpty_ThrowsValidation",
    "email": "   ",
    "userExists": false,
    "alreadyVerified": false,
    "isDevelopment": false,
    "expectedException": "Validation",
    "expectVerificationLink": false
  },
  {
    "caseName": "UserNotFound_ReturnsGenericMessage",
    "email": "notfound@example.com",
    "userExists": false,
    "alreadyVerified": false,
    "isDevelopment": true,
    "expectedException": null,
    "expectVerificationLink": false
  },
  {
    "caseName": "AlreadyVerified_ThrowsAppException",
    "email": "user@example.com",
    "userExists": true,
    "alreadyVerified": true,
    "isDevelopment": false,
    "expectedException": "AlreadyVerified",
    "expectVerificationLink": false
  },
  {
    "caseName": "NotVerified_Development_ReturnsLink",
    "email": "user@example.com",
    "userExists": true,
    "alreadyVerified": false,
    "isDevelopment": true,
    "expectedException": null,
    "expectVerificationLink": true
  },
  {
    "caseName": "NotVerified_Production_HidesLink",
    "email": "user@example.com",
    "userExists": true,
    "alreadyVerified": false,
    "isDevelopment": false,
    "expectedException": null,
    "expectVerificationLink": false
  }
